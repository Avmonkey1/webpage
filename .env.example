# Server port (default: 3000)
PORT=3000

# Path to system Chromium — avoids downloading Puppeteer's bundled browser
# Ubuntu/Debian: run  `which chromium-browser`  to find the path
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# LinkedIn session cookie — greatly improves success rate
# How to get it:
#   1. Log into LinkedIn in Chrome
#   2. F12 → Application → Cookies → https://www.linkedin.com
#   3. Copy the value of the `li_at` cookie
LINKEDIN_LI_AT_COOKIE=

# Optional: also copy the JSESSIONID cookie value from the same page
LINKEDIN_JSESSIONID=
